<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="rover_wheel" params="prefix parent mesh_file *origin">
    
    <joint name="${prefix}_wheel_joint" type="continuous">
      <xacro:insert_block name="origin" />
      <parent link="${parent}"/>
      <child link="${prefix}_wheel_link"/>
      <axis xyz="0 0 1"/> <limit effort="10.0" velocity="1.0"/>
    </joint>

    <link name="${prefix}_wheel_link">
      <visual name="${prefix}_visual">
        <origin rpy="-1.57080 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh filename="file://$(find rover_description)/meshes/dae/${mesh_file}" scale="0.05000 0.05000 0.12500"/>
        </geometry>
      </visual>

      <collision name="${prefix}_collision">
        <origin rpy="-1.57080 0.00000 0.00000" xyz="0.00000 0.00000 0.00000"/>
        <geometry>
          <mesh filename="file://$(find rover_description)/meshes/dae/${mesh_file}" scale="0.05000 0.05000 0.12500"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="20.0"/>
        <origin rpy="0 0 0" xyz="0 0 0.00008"/>
        <inertia ixx="1.29049" ixy="0.0" ixz="0.0" iyy="2.27308" iyz="0.0" izz="1.29044"/>
      </inertial>
    </link>
    
  </xacro:macro>
</robot>