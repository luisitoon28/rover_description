<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_controler">
    
    <!-- Plugin de Gazebo para cargar ros2_control -->
    <gazebo>
      <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
        <!-- Este es el paquete que acabas de generar con el asistente -->
        <parameters>$(find rover_moveit_config)/config/ros2_controllers.yaml</parameters>
      </plugin>
    </gazebo>

    <!-- Configuración de interfaces para MoveIt -->
    <ros2_control name="GazeboSimSystem" type="system">
      <hardware>
        <plugin>gz_ros2_control::GazeboSimSystem</plugin>
      </hardware>

      <!-- Articulación 1 (Hombro) -->
      <joint name="scara_arm_1_link_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Articulación 3 (Codo) -->
      <joint name="scara_arm_3_link_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Giro del actuador final -->
      <joint name="Cylinder_rotational_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Elevación Vertical (Prismático) -->
      <joint name="Cylinder_vertical_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Gripper Izquierdo -->
      <joint name="left_grip_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

      <!-- Gripper Derecho -->
      <joint name="right_grip_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>

    </ros2_control>
  </xacro:macro>

</robot>