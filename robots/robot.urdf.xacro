<?xml version="1.0"?>
<!-- created with Phobos 1.0.1 "Capricious Choutengan" -->
<robot name="robot" xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find rover_description)/urdf/base/rover_base.urdf.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/wheels/rover_wheel.urdf.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/wheels/axis.urdf.xacro"/>
  <xacro:include filename="$(find rover_description)/urdf/arm/arm.urdf.xacro"/>
  
  <xacro:property name="Front_wheel_offset_x" value="1.6"/>
  <xacro:property name="Middle_wheel_offset_x" value="-0.1"/>
  <xacro:property name="Back_wheel_offset_x" value="-1.4"/>
  <xacro:property name="Axis_offset_y" value="0.70"/> 
  <xacro:property name="Axis_offset_z" value="-1.05"/>
  <xacro:property name="Axis_to_wheel_offset_y" value="0.2"/>
  <xacro:include filename="$(find rover_description)/urdf/utils/envase.urdf.xacro"/>

  <!-- BASE -->
  <xacro:robot_base/>

  <!-- ENVASE -->
  <xacro:Envase parent="base_link">
    <origin rpy="0.0 0.0 0.0" xyz="-0.61197 -0.03002 0.34359"/>
  </xacro:Envase>

  <!-- AXIS -->
  <xacro:Axis prefix="front_right" parent="base_link">
    <origin xyz="${Front_wheel_offset_x} ${Axis_offset_y} ${Axis_offset_z}" rpy="0 0 0"/>
  </xacro:Axis>

  <xacro:Axis prefix="middle_right" parent="base_link">
    <origin xyz="${Middle_wheel_offset_x} ${Axis_offset_y} ${Axis_offset_z}" rpy="0 0 0"/>
  </xacro:Axis>

  <xacro:Axis prefix="back_right" parent="base_link">
    <origin xyz="${Back_wheel_offset_x} ${Axis_offset_y} ${Axis_offset_z}" rpy="0 0 0"/>
  </xacro:Axis>

  <xacro:Axis prefix="front_left" parent="base_link">
    <origin xyz="${Front_wheel_offset_x} -${Axis_offset_y} ${Axis_offset_z}" rpy="0 0 0"/>
  </xacro:Axis>

  <xacro:Axis prefix="middle_left" parent="base_link">
    <origin xyz="${Middle_wheel_offset_x} -${Axis_offset_y} ${Axis_offset_z}" rpy="0 0 0"/>
  </xacro:Axis>

  <xacro:Axis prefix="back_left" parent="base_link">
    <origin xyz="${Back_wheel_offset_x} -${Axis_offset_y} ${Axis_offset_z}" rpy="0 0 0"/>
  </xacro:Axis>

  <!-- WHEELS -->
  <xacro:rover_wheel prefix="front_right" parent="front_right_axis_link" mesh_file="Cube.006.dae">
    <origin xyz="0 ${Axis_to_wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
  </xacro:rover_wheel>

  <xacro:rover_wheel prefix="middle_right" parent="middle_right_axis_link" mesh_file="Cube.006.dae">
    <origin xyz="0 ${Axis_to_wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
  </xacro:rover_wheel>

  <xacro:rover_wheel prefix="back_right" parent="back_right_axis_link" mesh_file="Cube.006.dae">
    <origin xyz="0 ${Axis_to_wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
  </xacro:rover_wheel>

  <xacro:rover_wheel prefix="front_left" parent="front_left_axis_link" mesh_file="Cube.008.dae">
    <origin xyz="0 -${Axis_to_wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
  </xacro:rover_wheel>

  <xacro:rover_wheel prefix="middle_left" parent="middle_left_axis_link" mesh_file="Cube.008.dae">
    <origin xyz="0 -${Axis_to_wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
  </xacro:rover_wheel>

  <xacro:rover_wheel prefix="back_left" parent="back_left_axis_link" mesh_file="Cube.008.dae">
    <origin xyz="0 -${Axis_to_wheel_offset_y} 0" rpy="${pi/2} 0 0"/>
  </xacro:rover_wheel>

  <!-- ARM -->
  <xacro:scara_arm parent="base_link">
    <origin xyz="0.71003 -0.01046 0.71815" rpy="0 0 0"/>
  </xacro:scara_arm>


</robot>